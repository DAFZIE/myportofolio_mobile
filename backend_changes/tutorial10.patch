+from django.contrib.auth import get_user_model
+from django.test import TestCase
+from rest_framework.test import APIClient
+
+
+class Tutorial10Tests(TestCase):
+    def setUp(self):
+        self.client = APIClient()
+        self.owner = get_user_model().objects.create_superuser('tutorial-owner', password='test-password-only')
+        self.member = get_user_model().objects.create_user('tutorial-member', password='test-password-only')
+        self.payload = {
+            'title': 'Flutter integration', 'description': 'Created using the mobile payload',
+            'tech_stack': 'Flutter, Django', 'project_url': 'https://example.com',
+            'project_image_url': '',
+        }
+
+    def test_public_read_login_create_logout_and_revoked_token(self):
+        self.assertEqual(self.client.get('/api/v1/projects/').status_code, 200)
+        self.assertEqual(self.client.post('/api/v1/projects/', self.payload, format='json').status_code, 401)
+        response = self.client.post('/api/v1/auth/token/', {'username': 'tutorial-owner', 'password': 'test-password-only'}, format='json')
+        self.assertEqual(response.status_code, 200)
+        self.client.credentials(HTTP_AUTHORIZATION='Token ' + response.data['token'])
+        response = self.client.post('/api/v1/projects/', self.payload, format='json')
+        self.assertEqual(response.status_code, 201)
+        self.assertEqual(response.data['tech_stack'], 'Flutter, Django')
+        self.assertEqual(response.data['category'], 'project-small')
+        self.assertEqual(self.client.post('/api/v1/auth/logout/').status_code, 204)
+        self.assertEqual(self.client.post('/api/v1/projects/', self.payload, format='json').status_code, 401)
+
+    def test_invalid_login_and_non_owner_permissions(self):
+        self.assertEqual(self.client.post('/api/v1/auth/token/', {'username': 'tutorial-owner', 'password': 'wrong'}, format='json').status_code, 400)
+        response = self.client.post('/api/v1/auth/token/', {'username': 'tutorial-member', 'password': 'test-password-only'}, format='json')
+        self.client.credentials(HTTP_AUTHORIZATION='Token ' + response.data['token'])
+        self.assertEqual(self.client.post('/api/v1/projects/', self.payload, format='json').status_code, 403)
+
+    def test_session_authentication_still_works(self):
+        self.client.force_login(self.owner)
+        self.assertEqual(self.client.post('/api/v1/projects/', self.payload, format='json').status_code, 201)
+
+    def test_local_cors_preflight(self):
+        response = self.client.options('/api/v1/projects/', HTTP_ORIGIN='http://localhost:5000', HTTP_ACCESS_CONTROL_REQUEST_METHOD='POST', HTTP_ACCESS_CONTROL_REQUEST_HEADERS='authorization,content-type')
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(response['Access-Control-Allow-Origin'], '*')
